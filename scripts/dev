#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

command="${1:-}"
if [[ $# -gt 0 ]]; then shift; fi
if ! command -v uv >/dev/null; then
  echo "Install uv 0.13.9, then run ./scripts/dev bootstrap." >&2
  exit 1
fi
export PYTHONPATH="$PWD/src"
case "$command" in
  bootstrap)
    # Check Docker, sync dependencies and start the two engines.
    docker compose version
    docker info --format '{{.ServerVersion}}'
    mkdir -p artifacts
    test -w artifacts
    uv sync --locked
    docker compose build worker
    docker compose up -d --wait postgres
    uv run --locked python -m migration_verifier.cli bootstrap
    ;;
  test)
    # Check source formatting, lint and types before running pytest.
    uv run --locked ruff format --check src tests
    uv run --locked ruff check src tests
    uv run --locked mypy
    uv run --locked pytest "$@"
    ;;
  demo|eval|verify)
    exec uv run --locked python -m migration_verifier.cli "$command" "$@"
    ;;
  *)
    echo "Usage: scripts/dev {bootstrap|test|demo|eval|verify}" >&2
    exit 2
    ;;
esac
